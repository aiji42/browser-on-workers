{
  "name": "browser-on-workers",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // workers.dev のサブドメインはアカウント名が出てしまうので閉じる。
  // 本物ではないと名前で言ってしまうドメインだけを開ける
  "workers_dev": false,
  "routes": [{ "pattern": "not-kitesurf.aiji42.dev", "custom_domain": true }],
  // Rust 側の Wasm はバンドルに同梱する
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    // 動的 Worker に文字列として渡すコード。Text で読むと中身が string で入る
    { "type": "Text", "globs": ["**/*.shim.js"] }
  ],
  // フォントは Static Assets に置いて、実行時に binding から読む。
  // Kitesurf も PageRenderer が Static Assets からフォントを取っている。
  // スクリプトサイズに含まれないので、フォントを増やしても上限に効かない
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // 明示しておく (既定値と同じ)。レイアウトから返ってこないページを踏んだときに、
  // ここで止まる。ja.wikipedia.org/wiki/コーヒー が実際にそうなる
  "limits": { "cpu_ms": 30000 },
  // 1 リクエストで 0.1〜2 秒の CPU を使うので、公開したままにするなら制限が要る。
  // 組み込みの Rate Limiting binding (unsafe.bindings の ratelimit) は効かなかった
  // (20 発通しても success しか返らない) ので、Durable Object で数える
  // ページの <script> を V8 で動かすための口。
  // Workers は文字列からコードを作れないが、動的 Worker のモジュールとして
  // 渡せば V8 が普通にコンパイルする。Kitesurf の PageScript がこれ
  "worker_loaders": [{ "binding": "LOADER" }],
  // 動的 Worker のネットワークを、この Worker 自身に通すための binding。
  //
  // Worker Loader の `globalOutbound` に Fetcher を渡すと、**子 Worker の
  // fetch が全部そこへ届く** (URL はページが要求したものそのまま)。
  // Kitesurf の SandboxOutbound がこの形。子のコードにネットワークの権限を
  // 持たせず、方針 (大きさの上限、自分のオリジンの拒否) を親の 1 箇所に置ける
  // 既定の fetch とは**別の entrypoint**に向ける。既定に混ぜると、ページが
  // 自分のオリジンを要求したときに自分のルーティングに落ちて再帰する
  "services": [
    { "binding": "OUTBOUND", "service": "browser-on-workers", "entrypoint": "Outbound" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RATE", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "observability": { "enabled": true }
}
