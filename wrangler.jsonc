{
  "name": "browser-on-workers",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Rust 側の Wasm と、埋め込むフォントをモジュールとして読み込む
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"] },
    { "type": "Data", "globs": ["**/*.ttf"] }
  ],
  "observability": { "enabled": true }
}
